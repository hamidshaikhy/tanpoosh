# Frontend (Next.js) configuration — placeholders only. Copy to .env.local for development
# (or run `python backend/scripts/sync_frontend_env.py`). Never put secrets in NEXT_PUBLIC_* vars.

# Internal URL the Next.js SERVER uses to read public catalog data from Django (not exposed to browsers)
INTERNAL_API_URL=http://127.0.0.1:8000
# Public origin of the site (same origin serves /api/v1 via the reverse proxy)
NEXT_PUBLIC_SITE_URL=http://localhost:8088
# Shared secret for Django -> Next cache revalidation (must equal backend FRONTEND_REVALIDATE_SECRET, >= 32 chars)
REVALIDATE_SECRET=change-me-to-a-long-random-value
# Development helpers (e.g. "fill sample data" in checkout). Must be false in production.
NEXT_PUBLIC_DEV_TOOLS=false
# Optional: extra origin allowed for images in CSP when media is served from object storage/CDN
MEDIA_ORIGIN=
