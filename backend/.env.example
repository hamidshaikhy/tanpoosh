# Local practice defaults. Generate actual secrets with scripts/init_local_env.py.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ENV=development
DJANGO_SECRET_KEY=GENERATE_A_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8088
CSRF_TRUSTED_ORIGINS=http://localhost:8088
POSTGRES_DB=tanpoosh
POSTGRES_USER=tanpoosh
POSTGRES_PASSWORD=SET_YOUR_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
RATELIMIT_REDIS_URL=redis://127.0.0.1:6379/2
MFA_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
MFA_DEV_BYPASS=true
FRONTEND_INTERNAL_URL=http://127.0.0.1:3000
FRONTEND_REVALIDATE_SECRET=GENERATE_A_RANDOM_SECRET
EMAIL_HOST=127.0.0.1
EMAIL_PORT=2525
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=SET_ONLY_FOR_SANDBOX_OR_LIVE_TESTING
PAYMENT_CALLBACK_URL=http://localhost:8088/api/v1/payments/callback
PAYMENT_RESULT_URL=http://localhost:8088/payment/result
OWNER_USERNAME=tanpoosh_admin
